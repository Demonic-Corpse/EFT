# =================================================================
# Nginx Reverse Proxy Configuration for Elite Football Training
# Main Site: elitefootballtraining.in
# Founder / Admin Portal: founder.elitefootballtraining.in
# VPS: 87.232.72.134
# =================================================================
# Place this file in: /etc/nginx/sites-available/elitefootballtraining.in
# Enable it: sudo ln -s /etc/nginx/sites-available/elitefootballtraining.in /etc/nginx/sites-enabled/
# Test config: sudo nginx -t
# Reload: sudo systemctl reload nginx
#
# Free SSL with Certbot:
# sudo apt install -y certbot python3-certbot-nginx
# sudo certbot --nginx -d elitefootballtraining.in -d www.elitefootballtraining.in -d founder.elitefootballtraining.in

# -------------------------------------------------------------
# 1. Main Website & Default Host
# -------------------------------------------------------------
server {
    listen 80;
    server_name elitefootballtraining.in www.elitefootballtraining.in 87.232.72.134;

    # Maximum upload size for photos and videos (matches multer 50MB)
    client_max_body_size 50M;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# -------------------------------------------------------------
# 2. Dedicated Founder / Admin Subdomain
# -------------------------------------------------------------
server {
    listen 80;
    server_name founder.elitefootballtraining.in;

    client_max_body_size 50M;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Root of founder subdomain automatically opens the Admin Dashboard / Login
    location = / {
        return 302 /admin/dashboard;
    }

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

